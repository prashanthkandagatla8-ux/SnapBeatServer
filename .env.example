# SnapBeat Server Environment Variables
# Copy this to .env and customize for your deployment

# Server port (default: 8772)
BEATCANVAS_PORT=8772

# Set to 1 for headless/server deployment (no browser popup)
BEATCANVAS_NO_BROWSER=1

# FFmpeg paths (auto-detected if on PATH; set explicitly for Docker/custom installs)
# BEATCANVAS_FFMPEG=/usr/bin/ffmpeg
# BEATCANVAS_FFPROBE=/usr/bin/ffprobe

# Output directory for rendered videos (default: <project_root>/output)
# BEATCANVAS_OUTPUT_DIR=/data/snapbeat/output

# Template directory (default: <project_root>/templates)
# BEATCANVAS_TEMPLATE_DIR=/data/snapbeat/templates

# Max concurrent render workers (default: 4)
BEATCANVAS_MAX_WORKERS=4

# Auto-delete rendered videos older than this many seconds (default: 3600 = 1 hour)
BEATCANVAS_OUTPUT_MAX_AGE=3600

# === Gateway Configuration (for gateway.py only) ===

# Comma-separated list of backend render servers
# SNAPBEAT_BACKENDS=http://vps1.example.com:8772,http://vps2.example.com:8772

# Serverless fallback URL (Cloud Run / Lambda) — used when all VPS servers are busy
# SNAPBEAT_SERVERLESS_URL=https://snapbeat-xxxxxx-uc.a.run.app

# Gateway port (default: 80)
# SNAPBEAT_GATEWAY_PORT=80
